global:
  smtp_smarthost: 'smtp.ionos.com:587'
  smtp_require_tls: true
  smtp_auth_password_file: /run/secrets/alertmanager_smtp_password

route:
  receiver: mad-mallards-email
  group_by:
    - alertname
    - severity
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: mad-mallards-email
    email_configs:
      - to: 'ALERTMANAGER_EMAIL_TO_PLACEHOLDER'
        from: 'ALERTMANAGER_EMAIL_FROM_PLACEHOLDER'
        auth_username: 'ALERTMANAGER_SMTP_USERNAME_PLACEHOLDER'
        send_resolved: true
