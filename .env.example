# General
TZ=America/New_York

PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring


# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO

ENABLE_PROXY_LABELS=true


# Dockge
DOCKGE_PORT=5001
DOCKGE_HOSTNAME=dockge.home


# Uptime Kuma
UPTIME_KUMA_PORT=3001
UPTIME_HOSTNAME=uptime.home

UPTIME_DB_NAME=uptime_kuma
UPTIME_DB_USER=uptime_kuma

# CHANGE BOTH:
UPTIME_DB_PASSWORD=CHANGE-TO-A-LONG-RANDOM-PASSWORD
UPTIME_DB_ROOT_PASSWORD=CHANGE-TO-A-DIFFERENT-LONG-RANDOM-PASSWORD


# Prometheus
PROMETHEUS_RETENTION=30d


# Grafana
GRAFANA_PORT=3002
GRAFANA_HOSTNAME=grafana.home

GRAFANA_ADMIN_USER=admin

# Keep this synchronized with what you intend for initial Grafana setup.
# For the existing Grafana volume, the password stored in Grafana itself
# takes precedence; we already reset yours successfully with grafana-cli.
GRAFANA_ADMIN_PASSWORD=YOUR-GRAFANA-PASSWORD

GRAFANA_ROOT_URL=http://localhost:3002
