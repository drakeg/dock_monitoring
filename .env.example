# =============================================================================
# Docker Monitoring Infrastructure
# Copy this file to .env and replace all placeholder secrets before startup.
# Never commit the resulting .env file.
# =============================================================================

# General
TZ=America/New_York

# Docker daemon socket on the host.
# Rootful/default Docker (for example Ubuntu): /var/run/docker.sock
# Rootless Docker (for example Fedora): /run/user/<UID>/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional backup destination used by scripts/backup.sh
# Prefer independent/off-host storage for real disaster recovery.
BACKUP_DIR=./backups

# Docker networks
PROXY_NETWORK=proxy
MONITORING_NETWORK=monitoring

# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO
ENABLE_PROXY_LABELS=true

# Dockge
DOCKGE_PORT=5001
DOCKGE_HOSTNAME=dockge.home

# Uptime Kuma
UPTIME_KUMA_PORT=3001
UPTIME_HOSTNAME=uptime.home

# Uptime Kuma database
UPTIME_DB_NAME=uptime_kuma
UPTIME_DB_USER=uptime_kuma
UPTIME_DB_PASSWORD=CHANGE-TO-A-LONG-RANDOM-PASSWORD
UPTIME_DB_ROOT_PASSWORD=CHANGE-TO-A-DIFFERENT-LONG-RANDOM-PASSWORD

# MariaDB monitoring exporter
# Create this least-privilege database account before starting mysqld-exporter.
MYSQLD_EXPORTER_USER=exporter
MYSQLD_EXPORTER_PASSWORD=CHANGE-TO-A-DIFFERENT-LONG-RANDOM-PASSWORD

# Prometheus
PROMETHEUS_RETENTION=30d

# Alertmanager
# Copy alertmanager/alertmanager.yml.example to alertmanager/alertmanager.yml and
# replace the non-secret SMTP address/username placeholders there.
# Compose supplies the SMTP password as a runtime secret from this variable.
ALERTMANAGER_SMTP_PASSWORD=CHANGE-TO-THE-SMTP-MAILBOX-PASSWORD

# Grafana
GRAFANA_PORT=3002
GRAFANA_HOSTNAME=grafana.home
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-TO-A-LONG-RANDOM-PASSWORD

# Direct LAN access is normally http://SERVER-IP:3002.
# Change this to the externally used Grafana URL when appropriate.
GRAFANA_ROOT_URL=http://localhost:3002
